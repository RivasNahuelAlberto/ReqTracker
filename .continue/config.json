{\n  \"models\": [\n    {\n      \"title\": \"Claude 3.5 Sonnet\",\n      \"provider\": \"anthropic\",\n      \"model\": \"claude-3-5-sonnet-20241022\",\n      \"apiKey\": \"${ANTHROPIC_API_KEY}\",\n      \"contextLength\": 200000\n    }\n  ],\n  \"mcp_servers\": {\n    \"render\": {\n      \"type\": \"render_mcp\",\n      \"description\": \"Render MCP Server - Logs, Deploys, Metrics\",\n      \"config\": {\n        \"apiKey\": \"${RENDER_API_KEY}\",\n        \"baseUrl\": \"https://api.render.com/v1\",\n        \"timeout\": 30000\n      }\n    }\n  },\n  \"context_providers\": [\n    {\n      \"name\": \"render\",\n      \"enabled\": true,\n      \"description\": \"Logs and metrics from Render.com\",\n      \"settings\": {\n        \"logLines\": 100,\n        \"includeMetrics\": true,\n        \"autoRefresh\": true,\n        \"refreshInterval\": 30000,\n        \"includeEnvironments\": false,\n        \"services\": [\"backend\", \"analytics\"],\n        \"defaultService\": \"backend\"\n      }\n    },\n    {\n      \"name\": \"codebase\",\n      \"enabled\": true,\n      \"description\": \"Local codebase - Backend files\",\n      \"settings\": {\n        \"roots\": [\"backend\", \"frontend\", \"analytics\"],\n        \"ignore\": [\n          \"node_modules\",\n          \"dist\",\n          \".git\",\n          \".env\",\n          \"*.lock\"\n        ]\n      }\n    }\n  ],\n  \"commands\": [\n    {\n      \"name\": \"logs-error\",\n      \"title\": \"Show backend errors\",\n      \"action\": \"@render logs --service backend --error --lines 50\"\n    },\n    {\n      \"name\": \"logs-follow\",\n      \"title\": \"Follow backend logs\",\n      \"action\": \"@render logs --follow --service backend\"\n    },\n    {\n      \"name\": \"health-check\",\n      \"title\": \"Check all services health\",\n      \"action\": \"@render health --all-services\"\n    },\n    {\n      \"name\": \"recent-deploys\",\n      \"title\": \"Show recent deploys\",\n      \"action\": \"@render deploys --service backend --limit 5\"\n    },\n    {\n      \"name\": \"metrics\",\n      \"title\": \"Show backend metrics\",\n      \"action\": \"@render service-metrics backend --period 1h\"\n    }\n  ],\n  \"analytics\": {\n    \"enabled\": false,\n    \"reason\": \"Disable analytics for privacy\"\n  },\n  \"customCommands\": [\n    {\n      \"name\": \"oauth-debug\",\n      \"description\": \"Debug OAuth errors\",\n      \"steps\": [\n        \"@render logs --service backend --search 'oauth|google|callback'\",\n        \"Look for error patterns\",\n        \"Correlate with backend/routes/auth.js\"\n      ]\n    },\n    {\n      \"name\": \"mongo-debug\",\n      \"description\": \"Debug MongoDB issues\",\n      \"steps\": [\n        \"@render logs --service backend --search 'mongo|connection|timeout'\",\n        \"@render service-metrics backend\",\n        \"Check MONGO_URI configuration\"\n      ]\n    },\n    {\n      \"name\": \"socket-debug\",\n      \"description\": \"Debug Socket.io issues\",\n      \"steps\": [\n        \"@render logs --follow --service backend --search 'socket|disconnect'\",\n        \"Analyze connection patterns\",\n        \"Review backend/index.js Socket.io config\"\n      ]\n    }\n  ],\n  \"editor\": {\n    \"theme\": \"dark\",\n    \"fontSize\": 13,\n    \"fontFamily\": \"Monaco, Menlo, Ubuntu Mono\",\n    \"formatOnSave\": true\n  },\n  \"extensions\": {\n    \"enabled\": true,\n    \"autoUpdate\": true\n  }\n}\n