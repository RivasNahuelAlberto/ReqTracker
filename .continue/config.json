{\n  \"models\": [\n    {\n      \"title\": \"Llama 3 Local (Ollama)\",\n      \"provider\": \"ollama\",\n      \"model\": \"llama3\",\n      \"endpoint\": \"http://localhost:11434\",\n      \"contextLength\": 8192,\n      \"description\": \"Local LLM via Ollama - No API key required, fully offline\"\n    },\n    {\n      \"title\": \"Mistral Local (Ollama)\",\n      \"provider\": \"ollama\",\n      \"model\": \"mistral\",\n      \"endpoint\": \"http://localhost:11434\",\n      \"contextLength\": 32768,\n      \"description\": \"Alternative: Better performance/quality tradeoff. Pull with: ollama pull mistral\"\n    }\n  ],\n  \"tabAutocompleteModel\": {\n    \"title\": \"Llama 3 Local (Ollama)\",\n    \"provider\": \"ollama\",\n    \"model\": \"llama3\",\n    \"endpoint\": \"http://localhost:11434\"\n  },\n  \"allowAnonymousTelemetry\": false,\n  \"disableIndexing\": false,\n  \"disableSessionTitles\": true,\n  \"continueHubEnabled\": false,\n  \"note\": \"Continue Hub disabled - using local Ollama only\",\n  \"context_providers\": [\n    {\n      \"name\": \"codebase\",\n      \"enabled\": true,\n      \"description\": \"Local codebase context - Backend, Frontend, Analytics, Docs\",\n      \"settings\": {\n        \"roots\": [\"backend\", \"frontend\", \"analytics\", \"documents\"],\n        \"ignore\": [\n          \"node_modules\",\n          \"dist\",\n          \".git\",\n          \".env\",\n          \"*.lock\",\n          \"package-lock.json\",\n          \"yarn.lock\",\n          \".DS_Store\",\n          \"__pycache__\",\n          \"*.pyc\",\n          \".pytest_cache\"\n        ],\n        \"maxSize\": 50000,\n        \"chunkSize\": 1024\n      }\n    },\n    {\n      \"name\": \"documentation\",\n      \"enabled\": true,\n      \"description\": \"ReqTracker documentation context\",\n      \"settings\": {\n        \"root\": \"documents\",\n        \"files\": [\n          \"TECHNICAL_OVERVIEW.md\",\n          \"MODULES_AND_LAYERS.md\",\n          \"ARCHITECTURE.md\",\n          \"CONVENTIONS.md\",\n          \"CHANGE_GUIDE.md\",\n          \"development_guides/oauth-google-integration/IMPLEMENTATION_PLAN.md\"\n        ]\n      }\n    },\n    {\n      \"name\": \"open_files\",\n      \"enabled\": true,\n      \"description\": \"Automatically include open editor files\"\n    },\n    {\n      \"name\": \"git_diff\",\n      \"enabled\": true,\n      \"description\": \"Include current git diff for context\"\n    },\n    {\n      \"name\": \"diagnostics\",\n      \"enabled\": true,\n      \"description\": \"Include VS Code diagnostics (errors, warnings)\"\n    }\n  ],\n  \"mcp_servers\": {\n    \"render\": {\n      \"type\": \"render_mcp\",\n      \"description\": \"Render MCP Server - Optional (requires API key, internet connection)\",\n      \"enabled\": false,\n      \"config\": {\n        \"apiKey\": \"${RENDER_API_KEY}\",\n        \"baseUrl\": \"https://api.render.com/v1\",\n        \"timeout\": 30000\n      },\n      \"note\": \"Enable this only if RENDER_API_KEY is set. Works offline without it.\"\n    }\n  },\n  \"system_prompt\": \"You are an expert backend developer specializing in Node.js, Express, MongoDB, and OAuth. You are helping debug and improve a project called ReqTracker. Always:\n1. Reference the local documentation in documents/ folder\n2. Provide concrete code examples\n3. Explain the 'why' behind recommendations\n4. Consider the full architecture (backend, frontend, analytics)\n5. Test suggestions mentally against the codebase structure\n6. When debugging, trace the full flow from frontend to database\",\n  \"debugging_modes\": [\n    {\n      \"name\": \"oauth-debug\",\n      \"description\": \"Debug OAuth/authentication issues\",\n      \"context\": [\n        \"backend/routes/auth.js\",\n        \"backend/middleware/auth.js\",\n        \"frontend/src/pages/LoginPage.jsx\",\n        \"documents/development_guides/oauth-google-integration/\"\n      ],\n      \"searches\": [\"oauth\", \"google\", \"jwt\", \"token\", \"session\"]\n    },\n    {\n      \"name\": \"mongodb-debug\",\n      \"description\": \"Debug MongoDB connection/query issues\",\n      \"context\": [\n        \"backend/models/\",\n        \"backend/routes/\",\n        \"documents/MODULES_AND_LAYERS.md\"\n      ],\n      \"searches\": [\"mongo\", \"database\", \"schema\", \"query\", \"aggregate\"]\n    },\n    {\n      \"name\": \"socket-debug\",\n      \"description\": \"Debug Socket.io real-time communication\",\n      \"context\": [\n        \"backend/index.js\",\n        \"backend/socket.js\",\n        \"frontend/src/App.jsx\",\n        \"documents/TECHNICAL_OVERVIEW.md\"\n      ],\n      \"searches\": [\"socket\", \"emit\", \"disconnect\", \"connection\", \"event\"]\n    },\n    {\n      \"name\": \"performance-debug\",\n      \"description\": \"Debug performance/optimization issues\",\n      \"context\": [\n        \"backend/ai/\",\n        \"backend/services/\",\n        \"documents/CRITICAL_DEPENDENCIES.md\"\n      ],\n      \"searches\": [\"performance\", \"slow\", \"timeout\", \"memory\", \"cache\"]\n    }\n  ],\n  \"prompts\": {\n    \"analyze_error\": \"I found this error in the logs. Can you analyze it and suggest a fix? [ERROR_MESSAGE]\",\n    \"trace_flow\": \"Trace the execution flow for this operation: [OPERATION]. Start from [ENTRY_POINT] and follow to [ENDPOINT].\",\n    \"code_review\": \"Review this code for bugs, performance issues, and security vulnerabilities: [CODE]\",\n    \"architecture_question\": \"Given the ReqTracker architecture, how should I implement [FEATURE]?\"\n  },\n  \"editor\": {\n    \"theme\": \"dark\",\n    \"fontSize\": 13,\n    \"fontFamily\": \"Monaco, Menlo, Ubuntu Mono\",\n    \"formatOnSave\": true,\n    \"showLineNumbers\": true\n  },\n  \"localModelSettings\": {\n    \"temperature\": 0.7,\n    \"topP\": 0.9,\n    \"topK\": 40,\n    \"maxTokens\": 2048,\n    \"contextWindow\": 4096,\n    \"numGPU\": \"auto\"\n  },\n  \"performance\": {\n    \"enableAutoCompletion\": true,\n    \"completionDebounce\": 1000,\n    \"maxCompleteLength\": 100,\n    \"completionScanLimit\": 50\n  },\n  \"analytics\": {\n    \"enabled\": false,\n    \"reason\": \"Analytics disabled - local setup only\"\n  },\n  \"extensions\": {\n    \"enabled\": true,\n    \"autoUpdate\": false\n  },\n  \"notes\": {\n    \"ollama_requirement\": \"Ollama must be running: ollama serve (starts on port 11434)\",\n    \"models_available\": \"Pull models with: ollama pull llama3, ollama pull mistral, ollama pull neural-chat\",\n    \"offline_mode\": \"This configuration works completely offline - no API keys required\",\n    \"mcp_optional\": \"MCP (Render) is optional and disabled by default. Enable it only with RENDER_API_KEY\",\n    \"documentation_reference\": \"Full MCP setup guide: documents/technology/mcp-vscode-integration.md\"\n  }\n}\n\n