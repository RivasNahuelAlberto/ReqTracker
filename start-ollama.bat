@echo off\nREM ============================================================================\nREM Start Ollama Server for ReqTracker Development (Windows)\nREM ============================================================================\nREM Script para iniciar Ollama con configuración optimizada para ReqTracker\nREM\nREM Uso:\nREM   start-ollama.bat (o simplemente hacer doble-click)\nREM\nREM Verificar después:\nREM   curl http://localhost:11434/api/tags\nREM ============================================================================\n\nsetlocal enabledelayedexpansion\n\necho.\necho ============================================================\necho Starting Ollama Server for ReqTracker Development\necho ============================================================\necho.\n\nREM Check if Ollama is installed\nwhere ollama >nul 2>&1\nif %ERRORLEVEL% NEQ 0 (\n    echo.\n    echo [X] Ollama is not installed or not in PATH!\n    echo.\n    echo Download and install Ollama from:\n    echo   https://ollama.ai/download\n    echo.\n    echo Then try running this script again.\n    echo.\n    pause\n    exit /b 1\n)\n\necho [OK] Ollama found\n\nREM Test if server is already running\nfor /f %%i in ('wmic os get localdatetime ^| find \"20\"') do set _datetime=%%i\ncurl -s http://localhost:11434/api/tags >nul 2>&1\nif %ERRORLEVEL% EQU 0 (\n    echo.\n    echo [!] Ollama server is already running on http://localhost:11434\n    echo.\n    echo Available models:\n    curl -s http://localhost:11434/api/tags 2>nul | findstr /r \"name\"\n    echo.\n    pause\n    exit /b 0\n)\n\necho.\necho Checking for required models...\necho.\n\nREM Check if at least one model is available\nollama list 2>nul | findstr /i \"llama3 mistral neural-chat\" >nul\nif %ERRORLEVEL% NEQ 0 (\n    echo.\n    echo [!] No models found. Pulling llama3...\n    echo     This may take 5-10 minutes on first run.\n    echo.\n    call ollama pull llama3\n) else (\n    echo [OK] Models available:\n    echo.\n    ollama list | findstr /i \"llama3 mistral neural-chat\"\n)\n\necho.\necho ============================================================\necho Starting Ollama server...\necho ============================================================\necho.\necho Server will listen on: http://localhost:11434\necho.\necho Keep this window open while using Continue in VS Code\necho.\necho To verify it works, open Command Prompt and run:\necho   curl http://localhost:11434/api/tags\necho.\necho Press Ctrl+C to stop the server\necho.\n\ncall ollama serve\n