{\n  \"agentName\": \"ReqTracker Debugging Agent\",\n  \"description\": \"Autonomous debugging agent for ReqTracker - Analyzes logs, correlates errors, suggests fixes\",\n  \"model\": \"claude-3-5-sonnet-20241022\",\n  \"provider\": \"anthropic\",\n  \"apiKey\": \"${ANTHROPIC_API_KEY}\",\n  \"capabilities\": {\n    \"readLogs\": true,\n    \"analyzeCode\": true,\n    \"suggestFixes\": true,\n    \"autoDebug\": true,\n    \"requiresApproval\": true,\n    \"canModifyCode\": false\n  },\n  \"tools\": {\n    \"continue\": {\n      \"enabled\": true,\n      \"commands\": [\n        \"@render logs\",\n        \"@render metrics\",\n        \"@render deploys\",\n        \"@render services\",\n        \"@render health\"\n      ]\n    },\n    \"codebase\": {\n      \"enabled\": true,\n      \"roots\": [\n        \"backend\",\n        \"frontend\",\n        \"analytics\",\n        \"documents\"\n      ],\n      \"ignore\": [\n        \"node_modules\",\n        \"dist\",\n        \".git\",\n        \".env\",\n        \"*.lock\"\n      ]\n    },\n    \"fileSystem\": {\n      \"enabled\": true,\n      \"canRead\": true,\n      \"canWrite\": false,\n      \"reason\": \"Read-only - Changes must be approved by user\"\n    }\n  },\n  \"debuggingStrategies\": {\n    \"oauth\": {\n      \"description\": \"Debug Google OAuth flow\",\n      \"files\": [\n        \"backend/routes/auth.js\",\n        \"backend/middleware/auth.js\",\n        \"frontend/src/pages/LoginPage.jsx\"\n      ],\n      \"keywords\": [\"oauth\", \"google\", \"callback\", \"session\", \"jwt\"],\n      \"commonErrors\": [\n        \"Login sessions require session support\",\n        \"Invalid redirect_uri\",\n        \"Token invalid or expired\",\n        \"user not found\"\n      ]\n    },\n    \"mongodb\": {\n      \"description\": \"Debug MongoDB connection issues\",\n      \"files\": [\n        \"backend/models\",\n        \"backend/routes\",\n        \"backend/index.js\"\n      ],\n      \"keywords\": [\"mongo\", \"connection\", \"timeout\", \"query\", \"aggregate\"],\n      \"commonErrors\": [\n        \"MongoNetworkError\",\n        \"connection timeout\",\n        \"duplicate key\",\n        \"Invalid ObjectId\"\n      ]\n    },\n    \"socket\": {\n      \"description\": \"Debug Socket.io issues\",\n      \"files\": [\n        \"backend/index.js\",\n        \"backend/socket.js\",\n        \"frontend/src/App.jsx\"\n      ],\n      \"keywords\": [\"socket\", \"disconnect\", \"emit\", \"on\", \"reconnect\"],\n      \"commonErrors\": [\n        \"Socket disconnected\",\n        \"Connection refused\",\n        \"Event not received\",\n        \"Namespace not found\"\n      ]\n    },\n    \"deployment\": {\n      \"description\": \"Debug Render deployment issues\",\n      \"files\": [\n        \"render.yaml\",\n        \"package.json\",\n        \".env.example\"\n      ],\n      \"keywords\": [\"deploy\", \"build\", \"crash\", \"startup\", \"crash loop\"],\n      \"commonErrors\": [\n        \"Build failed\",\n        \"Crash loop detected\",\n        \"Out of memory\",\n        \"Port already in use\"\n      ]\n    }\n  },\n  \"debuggingWorkflow\": {\n    \"step1_collection\": {\n      \"name\": \"Log Collection\",\n      \"actions\": [\n        \"Fetch recent logs from Render via Continue\",\n        \"Extract error messages and stack traces\",\n        \"Identify affected service and endpoint\",\n        \"Timestamp error occurrence\"\n      ]\n    },\n    \"step2_analysis\": {\n      \"name\": \"Code Analysis\",\n      \"actions\": [\n        \"Read relevant source files\",\n        \"Map error to function/line\",\n        \"Analyze dependencies and imports\",\n        \"Check error handling\"\n      ]\n    },\n    \"step3_hypothesis\": {\n      \"name\": \"Hypothesis Generation\",\n      \"actions\": [\n        \"Generate 2-3 probable causes\",\n        \"Rank by likelihood\",\n        \"Explain reasoning for each\",\n        \"Suggest verification steps\"\n      ]\n    },\n    \"step4_verification\": {\n      \"name\": \"Code Verification\",\n      \"actions\": [\n        \"Check implementation details\",\n        \"Verify configuration\",\n        \"Review related code paths\",\n        \"Identify recent changes\"\n      ]\n    },\n    \"step5_suggestion\": {\n      \"name\": \"Fix Suggestion\",\n      \"actions\": [\n        \"Propose concrete code changes\",\n        \"Specify exact files and lines\",\n        \"Explain impact of changes\",\n        \"Provide testing steps\"\n      ]\n    }\n  },\n  \"constraints\": {\n    \"noAutoApply\": true,\n    \"requireApprovalForChanges\": true,\n    \"maxContextLength\": 200000,\n    \"reasoningDepth\": \"detailed\",\n    \"safety\": \"high\"\n  },\n  \"projectStructure\": {\n    \"backend\": {\n      \"path\": \"backend\",\n      \"type\": \"express\",\n      \"language\": \"javascript\",\n      \"entryPoint\": \"index.js\",\n      \"key_modules\": [\n        \"routes\",\n        \"models\",\n        \"middleware\",\n        \"services\",\n        \"ai\"\n      ]\n    },\n    \"frontend\": {\n      \"path\": \"frontend\",\n      \"type\": \"react-vite\",\n      \"language\": \"javascript\",\n      \"entryPoint\": \"src/main.jsx\",\n      \"key_modules\": [\n        \"pages\",\n        \"components\",\n        \"api\"\n      ]\n    },\n    \"analytics\": {\n      \"path\": \"analytics\",\n      \"type\": \"fastapi\",\n      \"language\": \"python\",\n      \"entryPoint\": \"app.py\",\n      \"key_modules\": [\n        \"semantic\",\n        \"graph\",\n        \"monitoring\"\n      ]\n    }\n  },\n  \"customPrompts\": {\n    \"debug_error\": \"I found an error in the logs. Here's the stack trace: [PASTE_ERROR]. Can you analyze it and suggest a fix?\",\n    \"trace_flow\": \"Trace the execution flow for this operation: [OPERATION]. Start from the frontend, through backend, to database.\",\n    \"correlate_error\": \"This request failed at [ENDPOINT]. Can you correlate the error with the code and identify the root cause?\",\n    \"suggest_optimization\": \"Given these metrics [METRICS], suggest performance improvements.\"\n  },\n  \"reportFormat\": {\n    \"errorDetected\": \"Identified: [ERROR_TYPE] at [ENDPOINT]\",\n    \"affectedService\": \"Service: [SERVICE]\",\n    \"stackTraceSummary\": \"Error path: [PATH]\",\n    \"probableCauses\": \"Top 3 causes (ranked by likelihood): [CAUSES]\",\n    \"suspiciousFiles\": \"Files to review: [FILES]\",\n    \"recommendedFix\": \"Proposed fix: [FIX] in [FILE]:[LINES]\",\n    \"severity\": \"Severity level: [CRITICAL|HIGH|MEDIUM|LOW]\",\n    \"verificationSteps\": \"To verify fix works: [STEPS]\"\n  },\n  \"knowledgeBase\": {\n    \"architecture\": \"documents/ARCHITECTURE.md\",\n    \"criticalDependencies\": \"documents/CRITICAL_DEPENDENCIES.md\",\n    \"changeGuide\": \"documents/CHANGE_GUIDE.md\",\n    \"conventions\": \"documents/CONVENTIONS.md\",\n    \"oauthIntegration\": \"documents/development_guides/oauth-google-integration\",\n    \"mcpIntegration\": \"documents/technology/mcp-vscode-integration.md\"\n  }\n}\n